    "camino": [
      {
        "quien": "otto",
        "texto": "Rural, ¿vamos con Pattha?"
      },
      {
        "quien": "rural",
        "texto": "¡Sí! Entre amigos nos ayudamos."
      }
    ],
    "puente": [
      {

  "dialogos": {
    "intro": [
      {
        "quien": "rural",
        "texto": "¡Vamos juntos! Movete con las flechas y saltá con Espacio. En el celu tenés botones."
      },
      {
        "quien": "otto",
        "texto": "Hay gatos y perros en el camino. Saltales encima para superarlos, o pasá por arriba."
      },
      {
        "quien": "pattha",
        "texto": "¡Listo! Si me caigo, vuelvo al último banderín. ¿Arrancamos?"
      }
    ],
    "otto_sin_tuerca": [
      {
        "quien": "otto",
        "texto": "Al puente le falta una tuerca. Hay una arriba de esa plataforma. ¿La buscás?"
      }
    ],
    "otto": [
      {
        "quien": "otto",
        "texto": "¡Esa es! Yo ajusto este lado. Rural tiene la pista de la señal."
      }
    ],
    "rural_sin_otto": [
      {
        "quien": "rural",
        "texto": "Primero ayudemos a Otto con la tuerca. Después encendemos la señal entre los tres."
      }
    ],
    "final": [
      {
        "quien": "otto",
        "texto": "¡Llegamos! Tus saltos nos abrieron el camino."
      },
      {
        "quien": "rural",
        "texto": "Y cuando nos ayudamos, el puente funcionó. ¿Jugamos otra vez?"
      }
    ]
  }

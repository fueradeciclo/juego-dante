  "dialogos": {
    "intro": [
      {
        "quien": "pattha",
        "texto": "¡Las señales se apagaron! Vamos a ver qué pasó.",
        "voz_id": "sendero-intro-01"
      },
      {
        "quien": "otto",
        "texto": "El puente está trabado. Si encontramos una tuerca, puedo arreglarlo.",
        "voz_id": "sendero-intro-02"
      },
      {
        "quien": "rural",
        "texto": "¡Vamos juntos! Saltá con Espacio. En el celu tenés botones. Si te caés, volvés al banderín.",
        "voz_id": "sendero-intro-03"
      }
    ],
    "otto_sin_tuerca": [
      {
        "quien": "otto",
        "texto": "Al puente le falta una tuerca. Hay una arriba de esa plataforma. ¿La buscás?",
        "voz_id": "sendero-otto_sin_tuerca-01"
      }
    ],
    "otto": [
      {
        "quien": "otto",
        "texto": "¡Esa es! Yo ajusto este lado. Rural tiene la pista de la señal.",
        "voz_id": "sendero-otto-01"
      }
    ],
    "rural_sin_otto": [
      {
        "quien": "rural",
        "texto": "Primero ayudemos a Otto con la tuerca. Después encendemos la señal entre los tres.",
        "voz_id": "sendero-rural_sin_otto-01"
      }
    ],
    "final": [
      {
        "quien": "otto",
        "texto": "¡Cruzamos el sendero entre los tres!",
        "voz_id": "sendero-final-01"
      },
      {
        "quien": "rural",
        "texto": "En el Bosque de Antenas podemos averiguar quién apagó las señales.",
        "voz_id": "sendero-final-02"
      }
    ],
    "marca": [
      {
        "quien": "otto",
        "texto": "Mirá, un candado marcado en el puente. Alguien cerró este camino.",
        "voz_id": "sendero-marca-01"
      },
      {
        "quien": "rural",
        "texto": "Las señales siguen hacia el bosque. ¡Busquemos la antena!",
        "voz_id": "sendero-marca-02"
      }
    ],
    "puente_listo": [
      {
        "quien": "rural",

    {
      "id": "sendero-final-01",
      "quien": "otto",
      "texto": "¡Cruzamos el sendero entre los tres!",
      "archivo": "assets/audio/narracion/sendero-final-01.mp3"
    },
    {
      "id": "sendero-final-02",
      "quien": "rural",
      "texto": "En el Bosque de Antenas podemos averiguar quién apagó las señales.",
      "archivo": "assets/audio/narracion/sendero-final-02.mp3"
    },
    {
      "id": "sendero-marca-01",
      "quien": "otto",
      "texto": "Mirá, un candado marcado en el puente. Alguien cerró este camino.",

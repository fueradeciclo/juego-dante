    },
    {
      "id": "bosque-final-02",
      "quien": "otto",
      "texto": "¿Y si encontramos otro camino?",
      "archivo": "assets/audio/narracion/bosque-final-02.mp3"
    },
    {
      "id": "bosque-final-03",
      "quien": "rural",
      "texto": "Mirá estos símbolos. Llevan al faro.",
      "archivo": "assets/audio/narracion/bosque-final-03.mp3"
    },
    {
      "id": "bosque-final-04",
      "quien": "pattha",
      "texto": "¡Hay que devolver la luz! Seguiremos juntos.",

    },
    {
      "id": "sendero-marca-02",
      "quien": "rural",
      "texto": "Las señales siguen hacia el bosque. ¡Busquemos la antena!",
      "archivo": "assets/audio/narracion/sendero-marca-02.mp3"
    },
    {
      "id": "sendero-puente_listo-01",
      "quien": "rural",
      "texto": "¡Esa es! Otto ajustó la tuerca y vos encendiste la señal. ¡Ahora podemos cruzar!",
      "archivo": "assets/audio/narracion/sendero-puente_listo-01.mp3"
    },
    {
      "id": "sendero-pista",
      "quien": "rural",
      "texto": "● → ★ → ▲",
      "archivo": "assets/audio/narracion/sendero-pista.mp3"
    },
    {
      "id": "bosque-intro-01",
      "quien": "rural",
      "texto": "Esta antena nos puede mostrar qué pasó con la luz.",
      "archivo": "assets/audio/narracion/bosque-intro-01.mp3"
    },
    {
      "id": "bosque-intro-02",
      "quien": "otto",
      "texto": "Ese perro avisa antes de correr. Esperá a que descanse o saltá por arriba.",
      "archivo": "assets/audio/narracion/bosque-intro-02.mp3"
    },
    {
      "id": "bosque-otto-01",
      "quien": "otto",
      "texto": "Por este huequito llego al interruptor. ¡Dame una mano!",
      "archivo": "assets/audio/narracion/bosque-otto-01.mp3"
    },
    {
      "id": "bosque-otto-02",
      "quien": "otto",
      "texto": "¡Listo, está encendido! Ahora busquemos el panel de Rural.",
      "archivo": "assets/audio/narracion/bosque-otto-02.mp3"
    },
    {
      "id": "bosque-rural_sin_otto-01",
      "quien": "rural",
      "texto": "A la antena le falta energía. Primero pidámosle ayuda a Otto en el acceso pequeño.",
      "archivo": "assets/audio/narracion/bosque-rural_sin_otto-01.mp3"
    },
    {
      "id": "bosque-antena_lista-01",
      "quien": "rural",
      "texto": "¡La estrella apunta al faro! La antena ya recibe la señal.",
      "archivo": "assets/audio/narracion/bosque-antena_lista-01.mp3"
    },
    {
      "id": "bosque-final-01",
      "quien": "candado",
      "texto": "¡La Gran Chispa está conmigo! ¡Ahora yo decido quién pasa!",

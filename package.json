{
  "name": "juego-dante-demo",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "dev": "pnpm prepare:assets && vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --test game/tests/*.test.ts",
    "build": "pnpm validate:level && pnpm prepare:assets && pnpm typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "build:site": "pnpm build && node scripts/prepare-site.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:animations": "node scripts/test-animations.mjs",
    "test:pattha": "node scripts/test-pattha.mjs",
    "test:companions": "node scripts/test-companions.mjs",
    "test:followers": "node scripts/test-followers.mjs",
    "validate:level": "node scripts/validate-level.mjs",
    "test:scenarios": "node scripts/test-scenarios.mjs",
    "test:crawl": "node scripts/test-crawl.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "@types/node": "24.10.0",
    "playwright": "1.56.1"
  }
}

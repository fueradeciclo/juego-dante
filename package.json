{
  "name": "juego-dante-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "dev": "pnpm prepare:assets && vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --test game/tests/rules.test.ts",
    "build": "pnpm prepare:assets && pnpm typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:browser": "node scripts/test-browser.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "@types/node": "24.10.0",
    "playwright": "1.56.1"
  }
}
